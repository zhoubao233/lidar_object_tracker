<launch>
  <arg name="world_frame" default="map" />
  <arg name="body_frame" default="base_link" />
  <arg name="rviz" default="true" />
  <arg name="lidar_topic" default="/livox/lidar" />
  <arg name="odom_topic" default="/mavros/local_position/odom" />
  <arg name="lidar_translation" />
  <arg name="lidar_quaternion" />
  <arg name="max_points" default="30000" />
  <arg name="config_file" default="$(find lidar_object_tracker)/config/tracking.yaml" />
  <arg name="lidar_frame" default="livox_frame" />
  <arg name="lidar_time_offset" default="0.0" />
  <arg name="max_scan_duration" default="0.15" />
  <arg name="max_odom_gap" default="0.1" />
  <arg name="max_wait" default="0.5" />
  <arg name="max_input_age" default="1.0" />
  <include file="$(find lidar_object_tracker)/launch/livox_mavros_real.launch">
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="body_frame" value="$(arg body_frame)" />
    <arg name="lidar_topic" value="$(arg lidar_topic)" />
    <arg name="odom_topic" value="$(arg odom_topic)" />
    <arg name="lidar_translation" value="$(arg lidar_translation)" />
    <arg name="lidar_quaternion" value="$(arg lidar_quaternion)" />
    <arg name="max_points" value="$(arg max_points)" />
    <arg name="lidar_frame" value="$(arg lidar_frame)" />
    <arg name="lidar_time_offset" value="$(arg lidar_time_offset)" />
    <arg name="max_scan_duration" value="$(arg max_scan_duration)" />
    <arg name="max_odom_gap" value="$(arg max_odom_gap)" />
    <arg name="max_wait" value="$(arg max_wait)" />
    <arg name="max_input_age" value="$(arg max_input_age)" />
  </include>
  <include file="$(find lidar_object_tracker)/launch/tracker.launch">
    <arg name="world_frame" value="$(arg world_frame)" />
    <arg name="rviz" value="$(arg rviz)" />
    <arg name="config_file" value="$(arg config_file)" />
  </include>
</launch>

